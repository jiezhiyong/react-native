{
  "name": "react-native-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start:dev": "APP_VARIANT=development expo start",
    "start:test": "APP_VARIANT=test expo start --no-dev",
    "start:prod": "expo start --no-dev --minify",
    "prebuild:dev": "APP_VARIANT=development expo prebuild",
    "prebuild:test": "APP_VARIANT=test expo prebuild",
    "prebuild": "expo prebuild",
    "run:android": "expo run:android",
    "run:ios:device": "expo run:ios --device",
    "run:ios:simulator": "expo run:ios",
    "build:android:debug": "APP_VARIANT=test NO_MINIFY=true ENABLE_DEBUG_PANEL=true FORCE_DEV_MODE=false expo prebuild -p android && cd android && ./gradlew assembleDebug",
    "build:ios:debug": "APP_VARIANT=test NO_MINIFY=true ENABLE_DEBUG_PANEL=true FORCE_DEV_MODE=false expo prebuild -p ios && cd ios && xcodebuild -workspace ChatQA.xcworkspace -scheme ChatQA -configuration Debug -archivePath build/ChatQA.xcarchive archive",
    "test": "jest --watchAll",
    "lint": "npx eslint app components lib store modules --ignore-pattern '**/node_modules/**' --fix --max-warnings 999",
    "typecheck": "tsc",
    "format": "eslint --fix . && prettier --write --ignore-unknown .",
    "postinstall": "npx tailwindcss -i ./global.css -o ./node_modules/.cache/nativewind/global.css",
    "analyze:web": "source-map-explorer 'dist/_expo/static/js/web/*.js' 'dist/_expo/static/js/web/*.js.map'",
    "analyze:ios": "source-map-explorer 'dist/_expo/static/js/ios/*.js' 'dist/_expo/static/js/ios/*.js.map'",
    "analyze:android": "source-map-explorer 'dist/_expo/static/js/android/*.js' 'dist/_expo/static/js/android/*.js.map'",
    "generate-i18n": "typesafe-i18n",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/coverage/**",
      "!**/backup/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**"
    ]
  },
