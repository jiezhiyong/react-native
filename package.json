{
  "name": "react-native-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "run:dev": "APP_VARIANT=development expo start",
    "run:pre": "APP_VARIANT=preview expo start --no-dev",
    "run:prod": "expo start --no-dev --minify",
    "prebuild:dev": "APP_VARIANT=development expo prebuild",
    "prebuild:pre": "APP_VARIANT=preview expo prebuild",
    "prebuild": "expo prebuild",
    "run:ios:simulator": "APP_VARIANT=development expo run:ios",
    "run:ios:device": "expo run:ios --device",
    "run:android": "expo run:android",
    "build:android:debug": "APP_VARIANT=preview NO_MINIFY=true FORCE_DEV_MODE=false expo prebuild -p android && cd android && ./gradlew assembleDebug",
    "build:ios:debug": "APP_VARIANT=preview NO_MINIFY=true FORCE_DEV_MODE=false expo prebuild -p ios && cd ios && xcodebuild -workspace ChatQADev.xcworkspace -scheme ChatQADev -configuration Debug -archivePath build/ChatQADev.xcarchive archive",
    "test": "jest --watchAll",
    "test:e2e": "maestro test e2e/",
    "test:e2e:single": "maestro test",
    "lint": "npx eslint app components lib store modules --ignore-pattern '**/node_modules/**' --fix --max-warnings 999",
    "typecheck": "tsc",
    "format": "eslint --fix . && prettier --write --ignore-unknown .",
    "postinstall": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./global.css -o ./node_modules/.cache/nativewind/global.css",
    "analyze:web": "source-map-explorer 'dist/_expo/static/js/web/*.js' 'dist/_expo/static/js/web/*.js.map'",
    "analyze:ios": "source-map-explorer 'dist/_expo/static/js/ios/*.js' 'dist/_expo/static/js/ios/*.js.map'",
    "analyze:android": "source-map-explorer 'dist/_expo/static/js/android/*.js' 'dist/_expo/static/js/android/*.js.map'",
    "generate-i18n": "typesafe-i18n"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/coverage/**",
      "!**/features/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**"
    ]
  },
